# Copy to .env.local for local development. Set the same values in Vercel.
# Never commit real values.

# Public site settings (safe to expose; shown on the site)
NEXT_PUBLIC_SITE_URL=https://thelawtoncollection.com
# Required by Massachusetts advertising rules. Shown in the footer.
NEXT_PUBLIC_BROKERAGE_NAME=
# Leave blank to hide. Do not guess.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_LICENSE=
NEXT_PUBLIC_EMAIL=

# Supabase (server only, never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional; email notifications are skipped when either is blank)
RESEND_API_KEY=
LEAD_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "The Lawton Collection <hello@thelawtoncollection.com>"
LEAD_FROM_EMAIL=

# Any long random string; salts the IP hash used for rate limiting
RATE_LIMIT_SALT=
