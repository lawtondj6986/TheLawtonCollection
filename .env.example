# Copy to .env.local for local development. Set the same values in Vercel.
# Never commit real values.

# Public site settings (safe to expose; shown on the site)
NEXT_PUBLIC_SITE_URL=https://thelawtoncollection.com
# Required by Massachusetts advertising rules. Shown in the footer.
# These are also the built-in defaults, from Michelle's CENTURY 21 profile.
NEXT_PUBLIC_BROKERAGE_NAME=CENTURY 21 North East
NEXT_PUBLIC_AGENT_TITLE=Broker Associate
NEXT_PUBLIC_C21_PROFILE_URL=https://www.century21.com/agent/detail/ma/west-bridgewater/agents/michelle-lawton/aid-P00200000FDdr1BaOAb46gME0hPdv5uyd982dZIH
# Michelle's public contact details (these are also the built-in defaults)
NEXT_PUBLIC_PHONE=508-942-1180
NEXT_PUBLIC_PHONE_TEL=+15089421180
NEXT_PUBLIC_EMAIL=Michelle.lawton@comcast.net
# Leave blank to hide. Do not guess.
NEXT_PUBLIC_LICENSE=

# Supabase (server only, never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional; email notifications are skipped when the key is blank)
RESEND_API_KEY=
LEAD_TO_EMAIL=Michelle.lawton@comcast.net
# A sender on a domain verified in Resend, e.g. "The Lawton Collection <hello@thelawtoncollection.com>"
LEAD_FROM_EMAIL=

# Any long random string; salts the IP hash used for rate limiting
RATE_LIMIT_SALT=
